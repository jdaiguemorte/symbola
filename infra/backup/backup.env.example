# Configuration de sauvegarde d'UN environnement (SOC-10, lot 22). Sur le VPS, copier en
#   /etc/symbola/backup/production.env  et  /etc/symbola/backup/staging.env
# (root:root, 0600), jamais dans le dépôt. Voir docs/runbooks/restauration.md.

# Emplacement du clone du dépôt sur le VPS (contient infra/compose/.env.<environnement>).
SYMBOLA_DIR=/opt/symbola

# Dépôt restic (lot 22, NFR-10, ADR 0051) : sur la Storage Box Hetzner, hors du VPS, dans
# le dossier du sous-compte de l'environnement. « symbola-production » est l'alias défini
# dans la configuration SSH (RESTIC_SSH_DIR/config) ; « restic » est le dossier du dépôt
# chez le sous-compte. Un dossier local reste accepté (développement, tests).
RESTIC_REPOSITORY=sftp:symbola-production:restic
# Dossier SSH de l'environnement (root:root, 0700, fichiers 0600) : config (modèle :
# infra/backup/ssh-config.example), known_hosts (empreintes vérifiées à la main) et
# id_ed25519 (clé du sous-compte). Monté en lecture seule dans le conteneur restic.
RESTIC_SSH_DIR=/etc/symbola/backup/production.ssh
# Mot de passe du dépôt : fichier root 0600, propre à l'environnement, copié aussi dans
# le gestionnaire de mots de passe de Julien (sans lui, les sauvegardes sont illisibles).
RESTIC_PASSWORD_FILE=/etc/symbola/backup/production.restic-password

# URL « push » de la sonde Uptime Kuma de cet environnement (secret : quiconque la
# connaît peut simuler une sauvegarde réussie). Vide = pas de signal.
BACKUP_PUSH_URL=

# Inclure les données d'Uptime Kuma (socle partagé) : true en production seulement.
INCLUDE_MONITORING=true

# Rétention (NFR-13) : 7 sauvegardes quotidiennes, 4 hebdomadaires, 12 mensuelles. Les
# copies instantanées de la Storage Box (10 jours) protègent en plus contre un VPS compromis.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12

# Contrôle (NFR-10) : chaque nuit, la structure du dépôt ; le dimanche (7), relecture de
# 10 % des données et relevé de la taille du dépôt (NFR-30).
CHECK_WEEKDAY=7
CHECK_SUBSET=10%
