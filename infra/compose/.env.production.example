# Environnement production — copier en .env.production sur le serveur,
# jamais committer la copie remplie. Secrets distincts du staging.
ENVIRONMENT_NAME=production
APP_DOMAIN=symbola.fr
APP_IMAGE_TAG=latest

GITHUB_REPOSITORY=jdaiguemorte/symbola

# Port différent du staging (toutes deux en boucle locale sur le même
# VPS) pour permettre un tunnel SSH vers l'une ou l'autre.
POSTGRES_PORT=5432
POSTGRES_DB=symbola
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_USER=symbola_app
POSTGRES_APP_PASSWORD=

S3_REGION=garage
S3_BUCKET=symbola
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Boîte Ionos dédiée (alertes@symbola.fr), partagée staging/production
# pour l'instant — un vrai service transactionnel reste à choisir plus
# tard si le volume le justifie (PRD §11).
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Symbola <alertes@symbola.fr>"

# Limites par conteneur (ADR 0016) : garde-fou contre un emballement, pas
# un réglage fin — à réviser après observation (docs/runbooks/surveillance.md).
# ClamAV recharge ses signatures en doublant brièvement sa mémoire.
POSTGRES_MEM_LIMIT=4g
POSTGRES_CPUS=2
GARAGE_MEM_LIMIT=1g
GARAGE_CPUS=1
CLAMAV_MEM_LIMIT=3g
CLAMAV_CPUS=1
APP_MEM_LIMIT=2g
APP_CPUS=2
