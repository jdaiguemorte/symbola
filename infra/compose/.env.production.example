# Environnement production — copier en .env.production sur le serveur,
# jamais committer la copie remplie. Secrets distincts du staging.
ENVIRONMENT_NAME=production
APP_DOMAIN=symbola.fr
APP_IMAGE_TAG=latest

GITHUB_REPOSITORY=jdaiguemorte/symbola

# Port différent du staging (toutes deux en boucle locale sur le même
# VPS) pour permettre un tunnel SSH vers l'une ou l'autre.
POSTGRES_PORT=5432
POSTGRES_DB=symbola
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_USER=symbola_app
POSTGRES_APP_PASSWORD=

S3_REGION=garage
S3_BUCKET=symbola
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Boîte Ionos dédiée (notifications@symbola.fr), partagée staging/production
# pour l'instant — un vrai service transactionnel reste à choisir plus
# tard si le volume le justifie (PRD §11).
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Symbola <notifications@symbola.fr>"

# Signature en ligne (DEV-02, ADR 0026). Laisser vide tant que Documenso
# n'est pas mis en service : la signature s'affiche « indisponible ».
# Mise en service (docs/runbooks/deploiement.md, § Signature) : secrets
# DOCUMENSO_* (openssl), bootstrap (base dédiée), COMPOSE_PROFILES=signature,
# compte administrateur Documenso, clé d'API, webhook, puis
# SIGNATURE_PROVIDER=documenso.
COMPOSE_PROFILES=
DOCUMENSO_DOMAIN=signature.symbola.fr
DOCUMENSO_DB_USER=documenso
DOCUMENSO_DB_NAME=documenso
DOCUMENSO_DB_PASSWORD=
# openssl rand -hex 32, une valeur différente pour chacun des trois.
DOCUMENSO_NEXTAUTH_SECRET=
DOCUMENSO_ENCRYPTION_KEY=
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=
# Certificat de scellement (PKCS#12 en base64, sur une seule ligne) et sa
# phrase secrète : runbook de déploiement. À garder aussi dans le
# gestionnaire de mots de passe.
DOCUMENSO_SIGNING_CERT_BASE64=
DOCUMENSO_SIGNING_PASSPHRASE=
# false seulement le temps de créer le compte administrateur de Documenso.
DOCUMENSO_DISABLE_SIGNUP=true
DOCUMENSO_API_KEY=
SIGNATURE_PROVIDER=
# openssl rand -hex 32 ; même valeur dans le champ « Secret » du webhook Documenso.
SIGNATURE_WEBHOOK_SECRET=

# Double authentification (lot 16, SEC-01, ADR 0037) : clé de chiffrement des
# secrets TOTP, openssl rand -base64 32, distincte de l'autre environnement.
# Requise (l'app ne démarre pas sans elle) ; à garder aussi dans le
# gestionnaire de mots de passe : perdue, chaque compte doit reconfigurer sa
# double authentification.
MFA_ENCRYPTION_KEY=

# Limites par conteneur (ADR 0016) : garde-fou contre un emballement, pas
# un réglage fin — à réviser après observation (docs/runbooks/surveillance.md).
# ClamAV recharge ses signatures en doublant brièvement sa mémoire.
POSTGRES_MEM_LIMIT=4g
POSTGRES_CPUS=2
GARAGE_MEM_LIMIT=1g
GARAGE_CPUS=1
CLAMAV_MEM_LIMIT=3g
CLAMAV_CPUS=1
APP_MEM_LIMIT=2g
APP_CPUS=2
DOCUMENSO_MEM_LIMIT=1g
DOCUMENSO_CPUS=1
