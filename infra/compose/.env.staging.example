# Environnement staging — copier en .env.staging sur le serveur, jamais
# committer la copie remplie. Domaine distinct de la production
# (CLAUDE.md §9 lot-0-socle) ; secrets distincts de la production.
ENVIRONMENT_NAME=staging
APP_DOMAIN=staging.symbola.fr
APP_IMAGE_TAG=latest

GITHUB_REPOSITORY=jdaiguemorte/symbola

# Port différent de la production (toutes deux en boucle locale sur le
# même VPS) pour permettre un tunnel SSH vers l'une ou l'autre.
POSTGRES_PORT=5433
POSTGRES_DB=symbola
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_USER=symbola_app
POSTGRES_APP_PASSWORD=

S3_REGION=garage
S3_BUCKET=symbola
S3_ACCESS_KEY=
S3_SECRET_KEY=

SMTP_HOST=
SMTP_PORT=587
