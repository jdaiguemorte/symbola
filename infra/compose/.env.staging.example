# Environnement staging — copier en .env.staging sur le serveur, jamais
# committer la copie remplie. Domaine distinct de la production
# (CLAUDE.md §9 lot-0-socle) ; secrets distincts de la production.
ENVIRONMENT_NAME=staging
APP_DOMAIN=staging.symbola.fr
APP_IMAGE_TAG=latest

GITHUB_REPOSITORY=jdaiguemorte/symbola

# Port différent de la production (toutes deux en boucle locale sur le
# même VPS) pour permettre un tunnel SSH vers l'une ou l'autre.
POSTGRES_PORT=5433
POSTGRES_DB=symbola
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_USER=symbola_app
POSTGRES_APP_PASSWORD=

S3_REGION=garage
S3_BUCKET=symbola
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Envoi des e-mails : Scaleway Transactional Email (choix de Julien du 19/11/2026, ADR 0102), formule
# Essential, région fr-par, sous-domaine d'envoi vérifié chez Scaleway (SPF, DKIM, DMARC).
# SMTP_USER : identifiant du projet Scaleway (Project ID) ; SMTP_PASSWORD : clé secrète d'une clé d'API
# IAM réservée à TEM. Port 587, chiffrement STARTTLS exigé par l'app dès qu'il y a une authentification
# (2587 si 587 est bloqué ; 465 en TLS direct). SMTP_FROM, pour les e-mails de Symbola (codes, comptes),
# est sur le même domaine vérifié.
# Jusqu'à l'activation (docs/runbooks/deploiement.md, § Lot 55), garder l'ancienne boîte IONOS :
# SMTP_HOST=smtp.ionos.fr, SMTP_PORT=465, SMTP_FROM="Symbola <notifications@symbola.fr>",
# SMTP_SENDER_MODE=shared.
SMTP_HOST=smtp.tem.scaleway.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Symbola <notifications@envoi-staging.symbola.fr>"
# Domaine d'envoi dédié (D1) : envoi-staging.symbola.fr en staging, pour garder sa réputation à part ; « organization » une fois le domaine vérifié :
# chaque organisation envoie depuis « <partie locale>@SMTP_FROM_DOMAIN ».
SMTP_FROM_DOMAIN=envoi-staging.symbola.fr
SMTP_SENDER_MODE=shared
# Webhook de remise (MSG-05) : « scaleway » et l'ARN du sujet Topics and Events relié au webhook TEM
# (plusieurs ARN séparés par des virgules). Pas de secret partagé : chaque message est signé par
# Scaleway. Vide tant que le webhook n'est pas créé (le journal reste à « envoyé »).
EMAIL_DELIVERY_WEBHOOK=
EMAIL_DELIVERY_WEBHOOK_TOPIC_ARN=
EMAIL_DELIVERY_WEBHOOK_SECRET=
# Documenso (compte administrateur) passe par le même SMTP : son adresse d'expéditeur, et
# DOCUMENSO_SMTP_SECURE=false sur le port 587 (STARTTLS), true sur 465.
DOCUMENSO_SMTP_FROM_ADDRESS=notifications@envoi-staging.symbola.fr
DOCUMENSO_SMTP_SECURE=false

# Signature en ligne (DEV-02, ADR 0026). Laisser vide tant que Documenso
# n'est pas mis en service : la signature s'affiche « indisponible ».
# Mise en service (docs/runbooks/deploiement.md, § Signature) : secrets
# DOCUMENSO_* (openssl), bootstrap (base dédiée), COMPOSE_PROFILES=signature,
# compte administrateur Documenso, clé d'API, webhook, puis
# SIGNATURE_PROVIDER=documenso.
COMPOSE_PROFILES=
DOCUMENSO_DOMAIN=signature.staging.symbola.fr
DOCUMENSO_DB_USER=documenso
DOCUMENSO_DB_NAME=documenso
DOCUMENSO_DB_PASSWORD=
# openssl rand -hex 32, une valeur différente pour chacun des trois.
DOCUMENSO_NEXTAUTH_SECRET=
DOCUMENSO_ENCRYPTION_KEY=
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=
# Certificat de scellement (PKCS#12 en base64, sur une seule ligne) et sa
# phrase secrète : runbook de déploiement. À garder aussi dans le
# gestionnaire de mots de passe.
DOCUMENSO_SIGNING_CERT_BASE64=
DOCUMENSO_SIGNING_PASSPHRASE=
# false seulement le temps de créer le compte administrateur de Documenso.
DOCUMENSO_DISABLE_SIGNUP=true
DOCUMENSO_API_KEY=
SIGNATURE_PROVIDER=
# openssl rand -hex 32 ; même valeur dans le champ « Secret » du webhook Documenso.
SIGNATURE_WEBHOOK_SECRET=

# Double authentification (lot 16, L16-SEC-01, ADR 0037) : clé de chiffrement des
# secrets TOTP, openssl rand -base64 32, distincte de l'autre environnement.
# Requise (l'app ne démarre pas sans elle) ; à garder aussi dans le
# gestionnaire de mots de passe : perdue, chaque compte doit reconfigurer sa
# double authentification.
MFA_ENCRYPTION_KEY=

# Chiffrement au niveau du champ (DAT-08, ADR 0079) : openssl rand -base64 32, différente de
# MFA_ENCRYPTION_KEY. Requise. À garder dans le gestionnaire de mots de passe : perdue, les
# valeurs chiffrées (agendas extérieurs, régimes des invités) sont perdues.
DATA_ENCRYPTION_KEY=

# Notifications push (lot 53, ARC-09, ADR 0095 et 0096) : paire de clés VAPID propre à cet
# environnement (node apps/symbola/scripts/generate-vapid-keys.mjs), gardée dans le gestionnaire de
# mots de passe. Requises. Changées, chaque appareil réactive le push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Fournisseur d'identité (lot 33, ADR 0067) : Logto, obligatoire (la connexion passe par lui).
# Mise en service (docs/runbooks/deploiement.md, § Fournisseur d'identité) : enregistrement DNS
# de LOGTO_DOMAIN, secrets (openssl rand -hex 32, distincts de l'autre environnement),
# bootstrap (base dédiée), puis `configure-identity`. Console d'administration seulement par un
# tunnel SSH sur LOGTO_ADMIN_PORT (boucle locale, port distinct de l'autre environnement).
LOGTO_DOMAIN=connexion.staging.symbola.fr
LOGTO_ADMIN_PORT=3003
LOGTO_DB_USER=logto
LOGTO_DB_NAME=logto
LOGTO_DB_PASSWORD=
LOGTO_M2M_APP_ID=symbola-bootstrap
LOGTO_M2M_SECRET=

# Suivi des erreurs (lot 40b, Q27, ADR 0077). Laisser vide tant que GlitchTip n'est pas mis en
# service : les erreurs restent au journal, avec leur référence. Mise en service
# (docs/runbooks/deploiement.md, § Suivi des erreurs) : secrets (openssl rand -hex 32),
# COMPOSE_PROFILES (ajouter « erreurs »), premier compte et projet par un tunnel SSH sur
# GLITCHTIP_LOCAL_PORT (port distinct de l'autre environnement), puis ERROR_TRACKING_DSN.
GLITCHTIP_LOCAL_PORT=8091
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=
ERROR_TRACKING_DSN=

# Limites par conteneur (ADR 0016) : le staging est bridé pour ne jamais
# pénaliser la production sur le VPS partagé (24 Go). ClamAV recharge ses
# signatures en doublant brièvement sa mémoire : ne pas descendre sous 2g.
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPUS=1
GARAGE_MEM_LIMIT=512m
GARAGE_CPUS=0.5
CLAMAV_MEM_LIMIT=2g
CLAMAV_CPUS=0.5
APP_MEM_LIMIT=1g
APP_CPUS=1
DOCUMENSO_MEM_LIMIT=768m
DOCUMENSO_CPUS=0.5
LOGTO_MEM_LIMIT=512m
LOGTO_CPUS=0.5
GLITCHTIP_MEM_LIMIT=512m
GLITCHTIP_CPUS=0.5
GLITCHTIP_DB_MEM_LIMIT=256m
GLITCHTIP_DB_CPUS=0.5
