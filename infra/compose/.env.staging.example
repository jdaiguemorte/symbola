# Environnement staging — copier en .env.staging sur le serveur, jamais
# committer la copie remplie. Domaine distinct de la production
# (CLAUDE.md §9 lot-0-socle) ; secrets distincts de la production.
ENVIRONMENT_NAME=staging
APP_DOMAIN=staging.symbola.fr
APP_IMAGE_TAG=latest

GITHUB_REPOSITORY=jdaiguemorte/symbola

# Port différent de la production (toutes deux en boucle locale sur le
# même VPS) pour permettre un tunnel SSH vers l'une ou l'autre.
POSTGRES_PORT=5433
POSTGRES_DB=symbola
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_USER=symbola_app
POSTGRES_APP_PASSWORD=

S3_REGION=garage
S3_BUCKET=symbola
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Boîte Ionos dédiée (alertes@symbola.fr), partagée staging/production
# pour l'instant — un vrai service transactionnel reste à choisir plus
# tard si le volume le justifie (PRD §11).
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Symbola <alertes@symbola.fr>"

# Signature en ligne (DEV-02, ADR 0021). Laisser vide tant que DocuSeal
# n'est pas mis en service : la signature s'affiche « indisponible ».
# Mise en service (docs/runbooks/deploiement.md, § Signature) :
# DOCUSEAL_DB_PASSWORD puis bootstrap, COMPOSE_PROFILES=signature, compte
# admin DocuSeal, clé d'API, webhook avec l'en-tête secret, puis
# SIGNATURE_PROVIDER=docuseal.
COMPOSE_PROFILES=
DOCUSEAL_DOMAIN=signature.staging.symbola.fr
DOCUSEAL_DB_USER=docuseal
DOCUSEAL_DB_NAME=docuseal
DOCUSEAL_DB_PASSWORD=
DOCUSEAL_API_KEY=
SIGNATURE_PROVIDER=
SIGNATURE_WEBHOOK_HEADER=X-Symbola-Webhook-Secret
# openssl rand -hex 32 ; même valeur dans le webhook DocuSeal.
SIGNATURE_WEBHOOK_SECRET=

# Limites par conteneur (ADR 0016) : le staging est bridé pour ne jamais
# pénaliser la production sur le VPS partagé (24 Go). ClamAV recharge ses
# signatures en doublant brièvement sa mémoire : ne pas descendre sous 2g.
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPUS=1
GARAGE_MEM_LIMIT=512m
GARAGE_CPUS=0.5
CLAMAV_MEM_LIMIT=2g
CLAMAV_CPUS=0.5
APP_MEM_LIMIT=1g
APP_CPUS=1
DOCUSEAL_MEM_LIMIT=512m
DOCUSEAL_CPUS=0.5
