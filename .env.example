# Copier en .env et remplir. Jamais de vraie valeur ici (CLAUDE.md §5) ;
# .env.example est le seul fichier .env* commité.

NODE_ENV=development
APP_PORT=3000

# PostgreSQL — connexion commune
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=symbola

# PostgreSQL — rôle admin (migrations et bootstrap des rôles/RLS
# uniquement, packages/db ; jamais utilisé par l'app qui tourne, SOC-05)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=

# PostgreSQL — rôle applicatif (utilisé par l'app en production ; ni
# propriétaire des tables, ni BYPASSRLS, SOC-05)
POSTGRES_APP_USER=symbola_app
POSTGRES_APP_PASSWORD=

# Stockage objet compatible S3 — Garage en dev/MVP (ADR 0015, remplace
# MinIO, SOC-08)
S3_ENDPOINT=localhost
S3_PORT=3900
S3_USE_SSL=false
S3_REGION=garage
S3_BUCKET=symbola
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Secrets internes du cluster Garage de dev (jamais dans garage.toml).
# Générer une fois : openssl rand -hex 32 (RPC), openssl rand -base64 32 (jetons)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=

# ClamAV (antivirus à l'envoi de fichier)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Mailpit (e-mails de dev — jamais d'e-mail réel hors production). Pas
# d'authentification en dev : SMTP_USER/PASSWORD restent vides.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Symbola <no-reply@symbola.test>"

# Signature en ligne (DEV-02, ADR 0026). Vide en dev : faux fournisseur
# (page /signature-fictive). Pour essayer le vrai Documenso en local :
# DOCUMENSO_DB_PASSWORD et les trois secrets (openssl rand -hex 32),
# DOCUMENSO_SIGNING_CERT_BASE64 (runbook de déploiement), bootstrap,
# `--profile signature up -d`, compte et clé d'API sur http://localhost:3010,
# puis SIGNATURE_PROVIDER=documenso. Le webhook ne peut pas viser une
# adresse locale (sécurité de Documenso) : Symbola relit alors l'état des
# demandes en attente lui-même, toutes les quelques minutes.
SIGNATURE_PROVIDER=
SIGNATURE_WEBHOOK_HEADER=X-Documenso-Secret
SIGNATURE_WEBHOOK_SECRET=
DOCUMENSO_API_URL=http://localhost:3010/api/v2
DOCUMENSO_API_KEY=
DOCUMENSO_DB_USER=documenso
DOCUMENSO_DB_NAME=documenso
DOCUMENSO_DB_PASSWORD=
DOCUMENSO_NEXTAUTH_SECRET=
DOCUMENSO_ENCRYPTION_KEY=
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=
DOCUMENSO_SIGNING_CERT_BASE64=
DOCUMENSO_SIGNING_PASSPHRASE=

# Carnet de prestataires (lot 11, ADR 0031). GEOCODER vide = points simulés
# hors production (« fake »), API de l'IGN en production ; « none » coupe
# le placement automatique. MAP_TILES_DIR : dossier du fond de carte
# (france.pmtiles et fonts/), vide = carte sans fond.
GEOCODER=
MAP_TILES_DIR=

# Chaîne des factures et encaissements (lot 23b, FAC-14, ADR 0061) : URL Push d'une
# sonde Uptime Kuma à part, appelée chaque jour par le contrôle de la chaîne
# (« down » en cas d'anomalie). Vide = pas d'alerte externe. Un secret.
LEDGER_CHECK_PUSH_URL=

# Double authentification (lot 16, L16-SEC-01, ADR 0037) : clé de chiffrement des
# secrets TOTP au repos, 32 octets en base64 (openssl rand -base64 32). Requise :
# l'app refuse de démarrer sans elle. Perdue = chaque compte reconfigure sa
# double authentification (à garder dans le gestionnaire de mots de passe).
MFA_ENCRYPTION_KEY=

# Fournisseur d'identité (lot 33, ADR 0067) : Logto, service `logto` du socle de dev
# (pages sur http://localhost:3001, console sur http://localhost:3002). Remplir
# LOGTO_DB_PASSWORD et LOGTO_M2M_SECRET (openssl rand -hex 32 chacun), lancer le bootstrap
# (base dédiée), démarrer le socle, puis `pnpm --filter @symbola/auth configure-identity`.
LOGTO_DB_USER=logto
LOGTO_DB_NAME=logto
LOGTO_DB_PASSWORD=
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_M2M_APP_ID=symbola-bootstrap
LOGTO_M2M_SECRET=
