# Copier en .env et remplir. Jamais de vraie valeur ici (CLAUDE.md §5) ;
# .env.example est le seul fichier .env* commité.

NODE_ENV=development
APP_PORT=3000

# PostgreSQL (infra/compose/docker-compose.dev.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=symbola
POSTGRES_USER=symbola_app
POSTGRES_PASSWORD=

# MinIO (stockage objet)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ClamAV (antivirus à l'envoi de fichier)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Mailpit (e-mails de dev — jamais d'e-mail réel hors production)
SMTP_HOST=localhost
SMTP_PORT=1025
