{
  "name": "@symbola/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./with-organization": "./src/with-organization.ts",
    "./schema/hello": "./src/schema/hello.ts",
    "./schema/hub": "./src/schema/hub.ts",
    "./schema/core": "./src/schema/core.ts",
    "./events/emit": "./src/events/emit.ts",
    "./events/worker": "./src/events/worker.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "bootstrap": "tsx scripts/bootstrap-roles.ts",
    "migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@symbola/config": "workspace:*",
    "@symbola/env": "workspace:*",
    "@symbola/testing": "workspace:*",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
