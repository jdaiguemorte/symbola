{
  "version": 1,
  "_source": "Lot 45 (POR-07, CRM-09, HUB-21 ; D6 à D8 ; ADR 0090) : questionnaires de départ (découverte, cérémonie, musiques, détails pratiques), que la planner ajoute à ses modèles puis adapte. Une question peut alimenter un champ de l'évènement (date, invités, budget, lieu, ville, style, type) : un champ vide se remplit, un écart est montré à la planner. Aucune question sur la santé, la religion ou les opinions (article 9 du RGPD) : les régimes passent par le module Invités, avec accord (lot 49). Les mots de « sensitiveWords » font afficher un avertissement à la planner qui écrit une telle question (DPO).",
  "sensitiveWords": {
    "fr": [
      "santé",
      "médical",
      "médicale",
      "maladie",
      "handicap",
      "allergie",
      "intolérance",
      "régime alimentaire",
      "religion",
      "religieux",
      "religieuse",
      "confession",
      "croyance",
      "culte",
      "politique",
      "opinion",
      "syndicat",
      "orientation sexuelle",
      "ethnique",
      "origine ethnique",
      "grossesse",
      "enceinte"
    ],
    "en": [
      "health",
