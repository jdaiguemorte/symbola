      "questions": [
        {
          "key": "event_date",
          "label": {
            "fr": "À quelle date pensez-vous ?",
            "en": "Which date do you have in mind?"
          },
          "nature": "date",
          "help": {
            "fr": "Une date approchée suffit ; vous pourrez la changer.",
            "en": "An approximate date is enough; you can change it."
          },
          "eventField": "event_date"
        },
        {
          "key": "city",
          "label": {
            "fr": "Dans quelle ville ou quelle région ?",
            "en": "In which town or area?"
          },
          "nature": "short_text",
          "eventField": "city"
        },
        {
          "key": "venue",
          "label": {
            "fr": "Avez-vous déjà un lieu de réception ?",
